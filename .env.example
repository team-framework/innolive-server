# inno-live-server 환경변수 예시
# 값은 config.go의 기본값입니다. 필요한 것만 복사해 .env로 쓰세요.

# ── 서버 ───────────────────────────────────────────────
HTTP_ADDR=:8000
HTTP_PORT=8000                       # Docker Compose 호스트 공개 포트
LOG_LEVEL=INFO                       # DEBUG|INFO|WARN|ERROR
PPROF_ENABLED=false                  # /debug/pprof/* 노출. 인증이 없으므로 프로파일링 중에만 켤 것

# ── AI 프라이버시(블러) ────────────────────────────────
AI_PRIVACY_MODE=bypass
AI_GRPC_ADDR=host.docker.internal:50051
AI_GRPC_TARGETS=
AI_GRPC_INSECURE=true
AI_GRPC_TIMEOUT=5s
AI_FRAME_WIRE_FORMAT=jpeg            # jpeg|raw
AI_FRAME_QUEUE_SIZE=2
AI_FAILURE_POLICY=blackout_latch     # blackout_latch|freeze
AI_TIMEOUT_LATCH_THRESHOLD=3
AI_PREFLIGHT_TIMEOUT=30s
AI_PREFLIGHT_REQUIRED=false
AI_PRIVACY_FIXED_DELAY=20ms          # fixed_delay 모드에서 적용
AI_PRIVACY_ME_IMAGE_PATH=
REFERENCE_STORE_PATH=

# ── FFmpeg ─────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFMPEG_SPAWN_CONCURRENCY=3
FFMPEG_ENCODER_THREADS=1

# ── 세션 ───────────────────────────────────────────────
MAX_SESSIONS=0                       # 0=무제한
SESSION_NEGOTIATION_TIMEOUT=30s
INNOLIVE_REQUIRE_SESSION_AUTH=true   # owner_token 인증. 벤치(pion-load)는 false 필요

# ── WebRTC / ICE ───────────────────────────────────────
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_ANNOUNCED_IP=
WEBRTC_UDP_MUX_PORT=0
WEBRTC_UDP_PORT_MIN=50002
WEBRTC_UDP_PORT_MAX=50020
WEBRTC_DISCONNECTED_GRACE=10s

# ── RTMP egress (발행자 오디오) ────────────────
# 송출 대상은 이제 서버 전역 키가 아니라 사용자별 연결 계정(/auth/youtube/connect)에서
# 나오며, 송출 개시는 POST /sessions/{id}/stream/start 로만 이루어집니다.
ENABLE_AUDIO_EGRESS=false            # 발행자 마이크(Opus)를 함께 송출. off면 무음
EGRESS_LATENCY_LOG=false             # ingest→egress 지연 p50/p95/max 로깅(측정용)
EGRESS_AUDIO_OFFSET_MS=0             # A/V 싱크 보정(오디오 -itsoffset, ms). 양수=오디오 지연
EGRESS_VIDEO_BITRATE=                # 송출 비트레이트 강제(예: 5000k). 비우면 해상도별 자동(≤720p→2500k, 초과→5000k)
# WebRTC 퍼블리셔는 대역폭에 따라 방송 도중 해상도를 바꾸는데, 서버가 그 변화를 감지하지 못해
# 송출 화질이 시작 시점 해상도에 묶인다(#121/#122). 아래 값을 지정하면 입력이 어떻게 변하든
# 그 해상도로 송출한다(종횡비 유지 후 레터박스, RTMP 재연결 없음). 720p 방송이면 1280x720 권장.
# 비우면 첫 프레임 해상도를 따르는 기존 동작을 유지한다. 짝수 WIDTHxHEIGHT만 허용한다.
EGRESS_VIDEO_SIZE=                   # 송출 해상도 고정(예: 1280x720). 비우면 첫 프레임 해상도를 따름

# 디코더 출력 해상도를 이 장변에 고정한다. 비우면(0) 기존 동작 그대로 첫 프레임
# 해상도에 묶인다 — WebRTC 퍼블리셔는 방송 초반 대역폭 추정이 낮을 때 저해상도로
# 보내므로 그 값이 세션 화질의 상한이 된다. 짧은 변은 소스 종횡비에서 유도하므로
# 세로 방송도 여백 없이 담긴다. 상한 1920은 AI 서버의 MAX_LONG_EDGE와 같다.
# 켜면 파이프라인 전 단계가 이 크기로 일하므로 GPU 부하가 크게 오른다 —
# MAX_SESSIONS 재측정 없이 프로덕션에 넣지 말 것.
# EGRESS_VIDEO_SIZE와 함께 쓰지 않기를 권한다(세로 소스가 가로 액자에 재수납되어
# 다운스케일 + 필러박스가 생긴다).
DECODER_PIN_LONG_EDGE=               # 디코더 출력 장변 고정(예: 1280). 비우면 첫 프레임 해상도를 따름

# ── PostgreSQL ─────────────────────────────────────────
# 운영에서는 sslmode=disable을 그대로 사용하면 안 된다. 사용하는 PostgreSQL 서비스의 TLS 연결 문자열을 사용해야 한다.
# 아래 값은 Docker Compose 로컬 개발용입니다. 운영 비밀번호는 GitHub Actions Secret으로 주입하세요.
POSTGRES_DB=innolive
POSTGRES_USER=innolive
POSTGRES_PASSWORD=innolive
DATABASE_URL=postgres://innolive:innolive@localhost:5432/innolive?sslmode=disable
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m

# auto: GORM AutoMigrate, disposable local DB only
# versioned: run embedded SQL migrations
# off: migration is handled externally
DATABASE_MIGRATION_MODE=auto

# Access / Refresh Token
AUTH_ACCESS_TOKEN_KEY_BASE64=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_REFRESH_TOKEN_ABSOLUTE_TTL=2160h
AUTH_TOKEN_ISSUER=innolive-server
AUTH_TOKEN_AUDIENCE=innolive-api
AUTH_TOKEN_CLOCK_SKEW=30s
AUTH_CORS_ALLOW_ALL_ORIGINS=false
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Google OAuth
# Web Client ID is the backend ID-token audience and is shared with the web and Android clients.
GOOGLE_OAUTH_WEB_CLIENT_ID=
# Android Client ID identifies the signed Android app (package name and SHA-1).
GOOGLE_OAUTH_ANDROID_CLIENT_ID=

# Apple OAuth
# APPLE_PRIVATE_KEY_PATH는 Apple Developer에서 받은 .p8 private key의 절대 경로입니다.
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# openssl rand -base64 32 로 생성한 32바이트 AES-256 키입니다. 절대로 저장소에 커밋하지 마세요.
AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY_BASE64=

# YouTube 송출 연동 (로그인용 Google OAuth와 별개의 전용 GCP 프로젝트/클라이언트)
# CLIENT_ID/SECRET 둘 다 설정해야 활성화되며, 활성 시 AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY_BASE64도 필요합니다.
# 클라이언트(네이티브 GoogleSignIn SDK 또는 웹 GIS 팝업)가 획득한 인가 코드를
# POST /auth/youtube/connect {server_auth_code, code_source} 로 받습니다. redirect URI 설정은 없습니다 —
# 교환 파라미터는 code_source(native|web_popup)별로 서버가 결정합니다.
# 웹 팝업을 쓰려면 GCP 콘솔의 웹 클라이언트에 "승인된 JavaScript 원본"(예: http://localhost:8000)이 등록돼야 합니다.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# Email/password authentication (SMTP + Redis)
# AUTH_EMAIL_SMTP_HOST가 비어 있으면 이메일 회원가입 API는 비활성화됩니다.
# 587 포트는 STARTTLS=true, 465 포트는 IMPLICIT_TLS=true 및 STARTTLS=false가 일반적입니다.
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_USERNAME=
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_SMTP_STARTTLS=true
AUTH_EMAIL_SMTP_IMPLICIT_TLS=false
AUTH_EMAIL_SENDER_ADDRESS=
AUTH_EMAIL_SENDER_NAME=InnoLive
# Docker Compose에서는 비워 두면 redis:6379가 사용됩니다.
# 로컬에서 go run ./cmd/server로 직접 실행할 때만 localhost:6379으로 설정하세요.
AUTH_EMAIL_REDIS_ADDR=
AUTH_EMAIL_REDIS_USERNAME=
AUTH_EMAIL_REDIS_PASSWORD=
AUTH_EMAIL_REDIS_DB=0
AUTH_EMAIL_VERIFICATION_CODE_TTL=5m
AUTH_EMAIL_PENDING_USER_TTL=30m
