# InnoLive Go 미디어 서버 systemd 템플릿 유닛 (컨테이너 런타임).
# /etc/systemd/system/innolive-server@.service 로 설치하고 슬롯(blue·green)을 인스턴스로 쓴다.
#
# 무중단 배포(#517): apply-release.sh가 쉬고 있는 슬롯에 새 태그를 띄우고, 지금 슬롯의
# 세션을 넘긴 뒤 지금 슬롯을 멈춘다. 평소에는 한 슬롯만 돈다. 슬롯 포트는
# /etc/innolive/server-slot-%i.env가 정한다(compose.prod.yaml 참고).
#
# server.env / server-secrets.env 는 여기서 읽지 않는다 — 컨테이너 환경변수는 compose의
# env_file 이 주입한다. 여기서 읽는 EnvironmentFile 은 compose 변수 치환용(INNOLIVE_IMAGE,
# INNOLIVE_TAG, INNOLIVE_APPLE_KEY_PATH)뿐이다.
#
# AI_PREFLIGHT_REQUIRED=true(server.env) 기준으로 부팅 프리플라이트가 활성화된다.
# 재부팅 직후 AI 워커(TensorRT 로딩)보다 먼저 뜨면 프리플라이트가 실패할 수 있는데,
# 그 경우 Restart=on-failure 가 15초 간격으로 재시도해 AI가 준비되는 즉시 정상 기동한다.

[Unit]
Description=InnoLive Go media server (container, slot %i)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
Environment=INNOLIVE_SLOT=%i
EnvironmentFile=/etc/innolive/deploy.env
EnvironmentFile=/opt/innolive/deploy/current_tag-%i
# --exit-code-from: 컨테이너 종료 코드를 compose가 그대로 반환하게 한다.
# 이게 없으면 서버가 비정상 종료해도 compose는 0을 반환해 Restart=on-failure가
# 발동하지 않는다(재부팅 직후 preflight 재시도 설계가 무력화됨).
ExecStart=/usr/bin/docker compose -f /opt/innolive/compose.prod.yaml up --no-log-prefix --exit-code-from server
ExecStop=/usr/bin/docker compose -f /opt/innolive/compose.prod.yaml down
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
