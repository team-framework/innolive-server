# inno-live-server 환경변수 예시
# 값은 config.go의 기본값입니다. 필요한 것만 복사해 .env로 쓰세요.

# ── 서버 ───────────────────────────────────────────────
HTTP_ADDR=:8000
HTTP_PORT=8000                       # Docker Compose 호스트 공개 포트
LOG_LEVEL=INFO                       # DEBUG|INFO|WARN|ERROR

# ── AI 프라이버시(블러) ────────────────────────────────
AI_PRIVACY_MODE=bypass
AI_GRPC_ADDR=host.docker.internal:50051
AI_GRPC_TARGETS=
AI_GRPC_INSECURE=true
AI_GRPC_TIMEOUT=5s
AI_FRAME_WIRE_FORMAT=jpeg            # jpeg|raw
AI_FRAME_QUEUE_SIZE=2
AI_FAILURE_POLICY=blackout_latch     # blackout_latch|freeze
AI_TIMEOUT_LATCH_THRESHOLD=3
AI_PREFLIGHT_TIMEOUT=30s
AI_PREFLIGHT_REQUIRED=false
AI_PRIVACY_FIXED_DELAY=20ms          # fixed_delay 모드에서 적용
AI_PRIVACY_ME_IMAGE_PATH=
REFERENCE_STORE_PATH=

# ── FFmpeg ─────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFMPEG_SPAWN_CONCURRENCY=3
FFMPEG_ENCODER_THREADS=1

# ── 세션 ───────────────────────────────────────────────
MAX_SESSIONS=0                       # 0=무제한
SESSION_NEGOTIATION_TIMEOUT=30s
INNOLIVE_REQUIRE_SESSION_AUTH=true   # owner_token 인증. 벤치(pion-load)는 false 필요

# ── WebRTC / ICE ───────────────────────────────────────
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_ANNOUNCED_IP=
WEBRTC_UDP_MUX_PORT=0
WEBRTC_UDP_PORT_MIN=50002
WEBRTC_UDP_PORT_MAX=50020
WEBRTC_DISCONNECTED_GRACE=10s

# ── YouTube RTMP egress (발행자 오디오) ────────────────
YOUTUBE_STREAM_KEY=
ENABLE_AUDIO_EGRESS=false            # 발행자 마이크(Opus)를 함께 송출. off면 무음
EGRESS_LATENCY_LOG=false             # ingest→egress 지연 p50/p95/max 로깅(측정용)
EGRESS_AUDIO_OFFSET_MS=0             # A/V 싱크 보정(오디오 -itsoffset, ms). 양수=오디오 지연

# ── PostgreSQL ─────────────────────────────────────────
# 운영에서는 sslmode=disable을 그대로 사용하면 안 된다. 사용하는 PostgreSQL 서비스의 TLS 연결 문자열을 사용해야 한다.
# 아래 값은 Docker Compose 로컬 개발용입니다. 운영 비밀번호는 GitHub Actions Secret으로 주입하세요.
POSTGRES_DB=innolive
POSTGRES_USER=innolive
POSTGRES_PASSWORD=innolive
DATABASE_URL=postgres://innolive:innolive@localhost:5432/innolive?sslmode=disable
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m

# auto: GORM AutoMigrate, disposable local DB only
# versioned: run embedded SQL migrations
# off: migration is handled externally
DATABASE_MIGRATION_MODE=auto

# Access / Refresh Token
AUTH_ACCESS_TOKEN_KEY_BASE64=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_REFRESH_TOKEN_ABSOLUTE_TTL=2160h
AUTH_TOKEN_ISSUER=innolive-server
AUTH_TOKEN_AUDIENCE=innolive-api
AUTH_TOKEN_CLOCK_SKEW=30s
AUTH_CORS_ALLOW_ALL_ORIGINS=false
AUTH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
